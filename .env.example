# Copy to .env or run `pnpm bootstrap`. Values below are non-secret placeholders.
CHANGEDESK_RUN_ID=replace-with-a-local-run-id
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-generated-local-secret
CHANGEDESK_MIGRATOR_PASSWORD=replace-with-a-generated-local-secret
CHANGEDESK_RUNTIME_PASSWORD=replace-with-a-generated-local-secret
CHANGEDESK_WORKER_PASSWORD=replace-with-a-generated-local-secret
ATLAS_DB_PASSWORD=replace-with-a-generated-local-secret
BOREAL_DB_PASSWORD=replace-with-a-generated-local-secret

CHANGEDESK_POSTGRES_PORT=5432
CHANGEDESK_API_PORT=4100
ATLAS_PORT=9001
BOREAL_PORT=9002

CHANGEDESK_MIGRATOR_DATABASE_URL=postgresql://changedesk_migrator:replace-with-a-generated-local-secret@127.0.0.1:5432/changedesk
CHANGEDESK_RUNTIME_DATABASE_URL=postgresql://changedesk_runtime:replace-with-a-generated-local-secret@127.0.0.1:5432/changedesk
CHANGEDESK_WORKER_DATABASE_URL=postgresql://changedesk_worker:replace-with-a-generated-local-secret@127.0.0.1:5432/changedesk
ATLAS_DATABASE_URL=postgresql://atlas_owner:replace-with-a-generated-local-secret@127.0.0.1:5432/atlas
BOREAL_DATABASE_URL=postgresql://boreal_owner:replace-with-a-generated-local-secret@127.0.0.1:5432/boreal

