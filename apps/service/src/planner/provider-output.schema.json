{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "kind": { "enum": ["candidate", "needs_clarification", "unsupported"] },
    "recipe": { "anyOf": [{ "$ref": "#/$defs/campaign" }, { "$ref": "#/$defs/category" }, { "$ref": "#/$defs/channel" }, { "type": "null" }] },
    "safeMessage": { "type": ["string", "null"], "maxLength": 500 }
  },
  "required": ["kind", "recipe", "safeMessage"],
  "additionalProperties": false,
  "$defs": {
    "compatibility": { "type": "object", "properties": { "adapter": { "const": "medusa-v2" }, "capabilityContract": { "const": "1" }, "verifiedMedusaVersion": { "const": "2.22.1" } }, "required": ["adapter", "capabilityContract", "verifiedMedusaVersion"], "additionalProperties": false },
    "selection": { "type": "object", "properties": { "resource": { "const": "medusa.product" }, "maxRecords": { "const": 100 }, "requireStatus": { "const": "published" } }, "required": ["resource", "maxRecords", "requireStatus"], "additionalProperties": false },
    "categoryParameter": { "type": "object", "properties": { "kind": { "const": "resource" }, "resource": { "const": "medusa.product_category" } }, "required": ["kind", "resource"], "additionalProperties": false },
    "channelParameter": { "type": "object", "properties": { "kind": { "const": "resource" }, "resource": { "const": "medusa.sales_channel" } }, "required": ["kind", "resource"], "additionalProperties": false },
    "recordRef": { "type": "object", "properties": { "$record": { "const": "id" } }, "required": ["$record"], "additionalProperties": false },
    "categoryRef": { "type": "object", "properties": { "$param": { "const": "categoryId" } }, "required": ["$param"], "additionalProperties": false },
    "channelRef": { "type": "object", "properties": { "$param": { "const": "channelId" } }, "required": ["$param"], "additionalProperties": false },
    "categoryStep": { "type": "object", "properties": { "id": { "const": "addCategory" }, "capability": { "const": "medusa.product_categories.products.add" }, "forEach": { "const": "selectedProducts" }, "dependsOn": { "type": "array", "maxItems": 0 }, "arguments": { "type": "object", "properties": { "productId": { "$ref": "#/$defs/recordRef" }, "categoryId": { "$ref": "#/$defs/categoryRef" } }, "required": ["productId", "categoryId"], "additionalProperties": false } }, "required": ["id", "capability", "forEach", "dependsOn", "arguments"], "additionalProperties": false },
    "channelStep": { "type": "object", "properties": { "id": { "const": "addChannel" }, "capability": { "const": "medusa.sales_channels.products.add" }, "forEach": { "const": "selectedProducts" }, "dependsOn": { "type": "array", "items": { "const": "addCategory" }, "maxItems": 1 }, "arguments": { "type": "object", "properties": { "productId": { "$ref": "#/$defs/recordRef" }, "channelId": { "$ref": "#/$defs/channelRef" } }, "required": ["productId", "channelId"], "additionalProperties": false } }, "required": ["id", "capability", "forEach", "dependsOn", "arguments"], "additionalProperties": false },
    "categoryField": { "type": "object", "properties": { "name": { "const": "categoryId" }, "control": { "const": "resource-picker" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 } }, "required": ["name", "control", "label"], "additionalProperties": false },
    "channelField": { "type": "object", "properties": { "name": { "const": "channelId" }, "control": { "const": "resource-picker" }, "label": { "type": "string", "minLength": 1, "maxLength": 80 } }, "required": ["name", "control", "label"], "additionalProperties": false },
    "category": { "type": "object", "properties": { "schemaVersion": { "const": "1.0" }, "recipeKey": { "const": "catalog.category.assign.v1" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "minLength": 1, "maxLength": 500 }, "compatibility": { "$ref": "#/$defs/compatibility" }, "parameters": { "type": "object", "properties": { "categoryId": { "$ref": "#/$defs/categoryParameter" } }, "required": ["categoryId"], "additionalProperties": false }, "selection": { "$ref": "#/$defs/selection" }, "requiredCapabilities": { "type": "array", "items": { "enum": ["medusa.products.list", "medusa.products.retrieve", "medusa.product_categories.retrieve", "medusa.product_categories.products.add"] }, "minItems": 4, "maxItems": 4 }, "steps": { "type": "array", "items": { "$ref": "#/$defs/categoryStep" }, "minItems": 1, "maxItems": 1 }, "ui": { "type": "object", "properties": { "kind": { "const": "action" }, "label": { "type": "string", "minLength": 1, "maxLength": 60 }, "fields": { "type": "array", "items": { "$ref": "#/$defs/categoryField" }, "minItems": 1, "maxItems": 1 } }, "required": ["kind", "label", "fields"], "additionalProperties": false } }, "required": ["schemaVersion", "recipeKey", "displayName", "description", "compatibility", "parameters", "selection", "requiredCapabilities", "steps", "ui"], "additionalProperties": false },
    "channel": { "type": "object", "properties": { "schemaVersion": { "const": "1.0" }, "recipeKey": { "const": "catalog.channel.assign.v1" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "minLength": 1, "maxLength": 500 }, "compatibility": { "$ref": "#/$defs/compatibility" }, "parameters": { "type": "object", "properties": { "channelId": { "$ref": "#/$defs/channelParameter" } }, "required": ["channelId"], "additionalProperties": false }, "selection": { "$ref": "#/$defs/selection" }, "requiredCapabilities": { "type": "array", "items": { "enum": ["medusa.products.list", "medusa.products.retrieve", "medusa.sales_channels.retrieve", "medusa.sales_channels.products.add"] }, "minItems": 4, "maxItems": 4 }, "steps": { "type": "array", "items": { "$ref": "#/$defs/channelStep" }, "minItems": 1, "maxItems": 1 }, "ui": { "type": "object", "properties": { "kind": { "const": "action" }, "label": { "type": "string", "minLength": 1, "maxLength": 60 }, "fields": { "type": "array", "items": { "$ref": "#/$defs/channelField" }, "minItems": 1, "maxItems": 1 } }, "required": ["kind", "label", "fields"], "additionalProperties": false } }, "required": ["schemaVersion", "recipeKey", "displayName", "description", "compatibility", "parameters", "selection", "requiredCapabilities", "steps", "ui"], "additionalProperties": false },
    "campaign": { "type": "object", "properties": { "schemaVersion": { "const": "1.0" }, "recipeKey": { "const": "catalog.campaign.prepare.v1" }, "displayName": { "type": "string", "minLength": 1, "maxLength": 80 }, "description": { "type": "string", "minLength": 1, "maxLength": 500 }, "compatibility": { "$ref": "#/$defs/compatibility" }, "parameters": { "type": "object", "properties": { "categoryId": { "$ref": "#/$defs/categoryParameter" }, "channelId": { "$ref": "#/$defs/channelParameter" } }, "required": ["categoryId", "channelId"], "additionalProperties": false }, "selection": { "$ref": "#/$defs/selection" }, "requiredCapabilities": { "type": "array", "items": { "enum": ["medusa.products.list", "medusa.products.retrieve", "medusa.product_categories.retrieve", "medusa.sales_channels.retrieve", "medusa.product_categories.products.add", "medusa.sales_channels.products.add"] }, "minItems": 6, "maxItems": 6 }, "steps": { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/categoryStep" }, { "$ref": "#/$defs/channelStep" }] }, "minItems": 2, "maxItems": 2 }, "ui": { "type": "object", "properties": { "kind": { "const": "action" }, "label": { "type": "string", "minLength": 1, "maxLength": 60 }, "fields": { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/categoryField" }, { "$ref": "#/$defs/channelField" }] }, "minItems": 2, "maxItems": 2 } }, "required": ["kind", "label", "fields"], "additionalProperties": false } }, "required": ["schemaVersion", "recipeKey", "displayName", "description", "compatibility", "parameters", "selection", "requiredCapabilities", "steps", "ui"], "additionalProperties": false }
  }
}
