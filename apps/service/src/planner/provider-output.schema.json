{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "oneOf": [
    {
      "properties": { "kind": { "const": "candidate" }, "recipe": { "type": "object" } },
      "required": ["kind", "recipe"],
      "additionalProperties": false
    },
    {
      "properties": { "kind": { "const": "needs_clarification" }, "safeMessage": { "type": "string", "minLength": 1, "maxLength": 500 } },
      "required": ["kind", "safeMessage"],
      "additionalProperties": false
    },
    {
      "properties": { "kind": { "const": "unsupported" }, "safeMessage": { "type": "string", "minLength": 1, "maxLength": 500 } },
      "required": ["kind", "safeMessage"],
      "additionalProperties": false
    }
  ]
}
