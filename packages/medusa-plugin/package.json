{
  "name": "@changedesk/medusa-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/medusa.ps1 plugin:build",
    "test:unit": "vitest run ../../tests/medusa/*.test.ts"
  },
  "exports": {
    "./package.json": "./package.json",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./bridge/*": "./.medusa/server/src/bridge/*.js",
    "./*": "./.medusa/server/src/*.js"
  },
  "peerDependencies": {
    "@medusajs/core-flows": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1"
  },
  "dependencies": {
    "@changedesk/react": "workspace:*",
    "canonicalize": "5.1.0"
  },
  "devDependencies": {
    "@medusajs/cli": "2.22.1",
    "@medusajs/core-flows": "2.22.1",
    "@medusajs/framework": "2.22.1",
    "@medusajs/medusa": "2.22.1",
    "@medusajs/test-utils": "2.22.1",
    "@swc/core": "1.15.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
